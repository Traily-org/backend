PORT=8080

DB_HOST=db
DB_PORT=5432
DB_USER=traily
DB_PASSWORD=traily
DB_NAME=traily
DB_SSLMODE=disable

# JWT: two different random secrets of at least 32 bytes each, e.g.
# openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Comma-separated IPs or CIDRs of the reverse proxies allowed to set
# X-Forwarded-For (empty: trust none, use the direct client IP).
TRUSTED_PROXIES=
